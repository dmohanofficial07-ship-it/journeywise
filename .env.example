# Copy to .env for local development. Never commit or paste real tokens in chat.
DUFFEL_ACCESS_TOKEN=
# sandbox or live; the provider's live_mode must match.
DUFFEL_MODE=sandbox
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OFFER_SIGNING_SECRET=
# Must also be true for live searches. Booking/payment endpoints do not exist yet.
ENABLE_LIVE_SEARCH=false
PORT=4173

ENABLE_SANDBOX_BOOKING=false
